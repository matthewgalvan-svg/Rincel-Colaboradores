# ------------------------------------------------------------------
# Rincel Colaboradores — variables de entorno (SIN secretos reales).
# Copia a .env (desarrollo) o configúralas en tu proveedor de hosting.
# Nunca subas .env al repositorio ni pegues llaves en chats.
# ------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development
# URL pública exacta del sitio (sin / final). Se usa en enlaces, webhooks y SEO.
APP_URL=http://localhost:3000

# PostgreSQL 15+.
DATABASE_URL=postgres://rincel:CAMBIAR@localhost:5432/rincel_dev
DATABASE_POOL_MAX=10

# Secreto de sesiones y de enlaces privados de pedidos (≥ 32 caracteres aleatorios).
# Genera uno con: openssl rand -base64 48
BETTER_AUTH_SECRET=

# ---------------- Pagos ----------------
# none | simulated (solo desarrollo) | mercadopago
PAYMENT_PROVIDER=simulated
# sandbox (credenciales de prueba) | production
MP_ENVIRONMENT=sandbox
# Access token de la aplicación de Mercado Pago (Tus integraciones → Credenciales).
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones → Webhooks → firma secreta).
MP_WEBHOOK_SECRET=
# ID de usuario de la cuenta que DEBE recibir los pagos (se verifica en cada pago).
MP_USER_ID=
MP_API_BASE=https://api.mercadopago.com
# Candado adicional: los cobros reales solo se habilitan con "true" (y MP_ENVIRONMENT=production).
PAYMENTS_LIVE_ENABLED=false

# ---------------- Envíos ----------------
# none (compras físicas bloqueadas) | manual (tarifa fija configurada en el panel) | simulated (solo desarrollo)
SHIPPING_PROVIDER=simulated

# ---------------- Correo (opcional) ----------------
# Cualquier proveedor SMTP. Ej.: smtps://usuario:contraseña@smtp.proveedor.com:465
SMTP_URL=
EMAIL_FROM="Rincel Colaboradores <no-responder@tu-dominio.mx>"

# ---------------- Archivos privados ----------------
# Directorio persistente para guías, eSIM e imágenes subidas (fuera de public/).
STORAGE_DIR=./storage

# ---------------- Trabajos programados ----------------
# Protege POST /api/cron (vencimientos, conciliación, guías y correos).
CRON_SECRET=

# ---------------- Analítica externa (opcional, con consentimiento) ----------------
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=

# Solo pruebas e2e: desactiva el límite de intentos de acceso (ignorado en producción).
# AUTH_RATE_LIMIT_DISABLED=1
